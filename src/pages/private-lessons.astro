<style>
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    background: #000;
  }

  .page {
    min-height: 100svh;
    padding: 2rem 1rem;
    color: #fff;
    background: linear-gradient(180deg, #151515 0%, #000 100%);
    font-family:
      "Aptos", "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  }

  .page * {
    box-sizing: border-box;
  }

  .hero,
  .content-layout {
    width: min(100%, 62rem);
    margin-inline: auto;
  }

  .hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .eyebrow,
  h1,
  .card h2,
  .pricing h2,
  .pricing-column h3,
  .cta h2 {
    font-family:
      "Arial Narrow", "Aptos Display", "Segoe UI Condensed", "Helvetica Neue",
      Arial, sans-serif;
    text-transform: uppercase;
  }

  .eyebrow {
    color: #ccc;
    letter-spacing: 0.08em;
    font-size: clamp(0.75rem, 2.5vw, 0.9rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 9vw, 5rem);
    line-height: 0.92;
    margin: 0.25rem 0 0.75rem;
    color: #fff;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .subtitle {
    color: #d0d0d0;
    font-size: clamp(1rem, 3vw, 1.15rem);
    max-width: 40rem;
    margin-inline: auto;
  }

  .content-layout {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-areas:
      "what commitment"
      "pricing pricing"
      "cta cta";
    gap: 1rem;
  }

  .what-card {
    grid-area: what;
  }

  .commitment-card {
    grid-area: commitment;
  }

  .pricing {
    grid-area: pricing;
  }

  .cta {
    grid-area: cta;
  }

  .card,
  .cta {
    border: 0.0625rem solid rgba(255, 255, 255, 0.15);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .card {
    padding: 1.25rem;
  }

  .card h2,
  .pricing h2 {
    color: #ff3333;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    margin: 0 0 0.9rem;
  }

  .card p,
  .card li,
  .pricing p {
    color: #cfcfcf;
    font-size: clamp(1rem, 2.6vw, 1.05rem);
    line-height: 1.75;
  }

  ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  li {
    margin-bottom: 0.35rem;
  }

  .pricing h2 {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .pricing-column {
    text-align: center;
    padding: 1rem 0;
  }

  .pricing-column h3 {
    color: #fff;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
  }

  .pricing-column p {
    margin: 0.25rem 0;
  }

  .sub {
    display: block;
    margin-top: 0.75rem;
    color: #fff;
    font-weight: 800;
  }

  .center {
    padding: 1.5rem 0;
    border-left: 0.0625rem solid rgba(255, 255, 255, 0.15);
    border-right: 0.0625rem solid rgba(255, 255, 255, 0.15);
  }

  .price-highlight {
    color: #ff3333 !important;
    font-size: clamp(2rem, 7vw, 2.75rem) !important;
    line-height: 1 !important;
    font-weight: 900 !important;
    margin: 0.5rem 0 0.75rem !important;
  }

  .muted {
    color: #aaa !important;
    font-size: clamp(0.85rem, 2.5vw, 1rem) !important;
  }

  .mobile-divider {
    display: none;
  }

  .cta {
    max-width: 40rem;
    margin: 2rem auto 0;
    padding: 1.5rem;
    text-align: center;
  }

  .cta h2 {
    color: #fff;
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    font-weight: 900;
    margin: 0 0 0.75rem;
  }

  .cta a {
    display: block;
    color: #ff3333;
    font-size: clamp(1.1rem, 4vw, 1.5rem);
    font-weight: 900;
    margin: 0.5rem 0;
    text-decoration: none;
    word-break: break-word;
  }

  @media (max-width: 64em) {
    .card p,
    .card li,
    .pricing p {
      font-size: clamp(1.05rem, 4vw, 1.15rem);
      line-height: 1.8;
    }

    .card h2,
    .pricing h2 {
      font-size: clamp(1.3rem, 4.5vw, 1.6rem);
    }

    .pricing-highlight {
      font-size: clamp(2.25rem, 9vw, 3rem) !important;
    }

    .content-layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "what"
        "pricing"
        "commitment"
        "cta";
    }

    .what-card,
    .commitment-card {
      text-align: center;
    }

    .what-card ul {
      display: inline-block;
      text-align: left;
      margin-inline: auto;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .center {
      border-left: none;
      border-right: none;
      padding: 1rem 0;
    }

    .mobile-divider {
      display: block;
      width: 100%;
      min-height: 0.125rem;
      margin: 1rem 0;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.45),
        transparent
      );
    }

    .card {
      padding: 1rem;
    }

    .cta {
      padding: 1.25rem;
      border-radius: 1.25rem;
    }

    .card,
    .pricing,
    .cta {
      max-width: 45rem;
      width: 90%;
      margin-inline: auto;
    }
  }
</style>
